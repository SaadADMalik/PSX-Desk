# Copy to .env and fill in. .env is git-ignored; never commit it.

# From https://console.groq.com/keys . Only the llm-gateway container receives it.
GROQ_API_KEY=

# Any long random strings. POSTGRES_PASSWORD is fixed when the volume is first
# created; the service passwords are (re)applied on every `migrate` run.
POSTGRES_PASSWORD=change-me-admin
GATEWAY_DB_PASSWORD=change-me-gateway
ORCHESTRATOR_DB_PASSWORD=change-me-orchestrator
MARKET_DATA_DB_PASSWORD=change-me-market-data
MEMORY_DB_PASSWORD=change-me-memory
BROKER_DB_PASSWORD=change-me-broker

# Approvals dashboard (http://127.0.0.1:8700). The session secret signs login cookies.
DASHBOARD_PASSWORD=change-me-dashboard
DASHBOARD_SESSION_SECRET=change-me-long-random-string

# Where host-side CLIs (the baseline agent) find the gateway and Jaeger.
LLM_GATEWAY_URL=http://127.0.0.1:8100
ORCHESTRATOR_URL=http://127.0.0.1:8200
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
