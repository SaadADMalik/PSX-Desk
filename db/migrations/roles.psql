-- Applied on every migrate run (not versioned): create service roles if missing and
-- (re)set their passwords from the environment. Rotating a password = change .env,
-- rerun `docker compose run --rm migrate`, restart the service.
SELECT format('CREATE ROLE %I LOGIN', r)
FROM (VALUES ('gateway'), ('orchestrator'), ('market_data'), ('memory'), ('broker')) AS v(r)
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = r)
\gexec

ALTER ROLE gateway PASSWORD :'gateway_pw';
ALTER ROLE orchestrator PASSWORD :'orchestrator_pw';
ALTER ROLE market_data PASSWORD :'market_data_pw';
ALTER ROLE memory PASSWORD :'memory_pw';
ALTER ROLE broker PASSWORD :'broker_pw';
